{
	admin off
	auto_https disable_redirects
	skip_install_trust
}

https://{{ vast_inference_hostname }}:{{ vast_inference_caddy_port }} {
	tls internal
	@models {
		method GET
		path /v1/models
	}
	@chat {
		method POST
		path /v1/chat/completions
	}
	route {
{% if vast_origin_bearer_key is defined %}
		@authorized header Authorization "Bearer {{ vast_origin_bearer_key }}"
		@unauthorized not header Authorization "Bearer {{ vast_origin_bearer_key }}"
		handle @models {
			respond @unauthorized 401
			reverse_proxy @authorized 127.0.0.1:{{ vast_inference_port }} {
				header_up -Authorization
			}
		}
		handle @chat {
			respond @unauthorized 401
			reverse_proxy @authorized 127.0.0.1:{{ vast_inference_port }} {
				header_up -Authorization
			}
		}
{% else %}
		reverse_proxy @models 127.0.0.1:{{ vast_inference_port }}
		reverse_proxy @chat 127.0.0.1:{{ vast_inference_port }}
{% endif %}
		handle {
			respond 404
		}
	}
}
